[Unit]
Description=iBanu MCP publico (proxy con X-API-Key)
After=network-online.target ibanu-mcp.service
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/ibanu-mcp-publico
ExecStart=/home/azureuser/iBanu/mcp/.venv/bin/uvicorn proxy_pub:app --host 0.0.0.0 --port 9001 --no-server-header
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
